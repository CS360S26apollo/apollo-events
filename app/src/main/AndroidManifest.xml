<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PeerTutoringApollo">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.BrowseTutorsActivity" android:exported="false" />
        <activity android:name=".ui.TutorDetailActivity" android:exported="false" />
        <activity android:name=".ui.EditProfileActivity" android:label="Profile Settings" android:exported="false" />
        <activity android:name=".ui.LoginActivity" android:exported="false" />
        <activity android:name=".ui.NewSessionRequestActivity" android:exported="false" />
        <activity android:name=".ui.TutorRequestsActivity" android:exported="false" />
        <activity android:name=".ui.TutorOffersActivity" android:exported="false" />
        <activity android:name=".ui.CounterOfferActivity" android:exported="false" />
        <activity android:name=".ui.RequestResultActivity" android:exported="false" />

        <activity
            android:name=".ui.MessagingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Availability Activities -->
        <activity
            android:name=".ui.AvailabilityDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WeeklyScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BlockedDatesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BufferPricingActivity"
            android:exported="false" />

        <!-- Fixed keyboard appearing on Messages/Dashboard -->
        <activity
            android:name=".ui.SessionRequestsActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name=".ui.RequestDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

    </application>

</manifest>