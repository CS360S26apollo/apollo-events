<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/btnBack"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Seed Test Data"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Populate Firestore with test tutors and session requests"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tutors card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Tutors"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#071A3D"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#4B5D7A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="Creates 4 test tutors with availability slots for Instant Book testing:\n\n• Aisha Malik — Math, Physics (40 tokens/hr)\n• Carlos Rivera — Chemistry, Biology (35 tokens/hr)\n• Priya Sharma — CS, Mathematics (50 tokens/hr)\n• Omar Siddiqui — Economics, History (30 tokens/hr)" />

                    <Button
                        android:id="@+id/btnSeedTutors"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Seed Test Tutors"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#089A3C"
                        app:cornerRadius="28dp" />

                    <TextView
                        android:id="@+id/tvSeedStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#4B5D7A"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Session Requests card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Session Requests"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#071A3D"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#4B5D7A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="Creates 3 fake student accounts and session requests targeting YOU (the logged-in tutor). Requests use your registered subjects so they appear in your Requests tab. Log in as a tutor before seeding." />

                    <Button
                        android:id="@+id/btnSeedRequests"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Seed Test Requests"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#8A2EFF"
                        app:cornerRadius="28dp" />

                    <TextView
                        android:id="@+id/tvSeedRequestsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#4B5D7A"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Student login info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#F3EEFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Student Account"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#071A3D"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#4B5D7A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:text="Sign up via the normal registration screen with:\n\nEmail:    test.student@apollo.test\nPassword: Test1234!\nRole:     Student\n\nThen return here and seed tutors. Tutors appear in Browse Tutors immediately." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
