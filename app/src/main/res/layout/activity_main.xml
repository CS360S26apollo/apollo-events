<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F8"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp" android:layout_height="90dp"
            android:layout_marginTop="40dp" android:layout_marginBottom="16dp"
            app:cardCornerRadius="26dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="20dp" android:src="@drawable/ic_app_logo" android:contentDescription="Logo"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Find Tutor" android:textColor="#071A3D"
            android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:layout_marginBottom="32dp"
            android:text="Create your account" android:textColor="#8B97A8" android:textSize="15sp"/>

        <!-- Role card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="I am a..." android:textColor="#071A3D"
                    android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <RadioGroup android:id="@+id/radioGroupRole"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/radioStudent"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="Student" android:textColor="#4B5D7A" android:textSize="15sp"
                        android:buttonTint="#8A2EFF" android:checked="true"/>
                    <RadioButton android:id="@+id/radioTutor"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="Tutor" android:textColor="#4B5D7A" android:textSize="15sp"
                        android:buttonTint="#8A2EFF"/>
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Email -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Email Address" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="#FFFFFF" app:hintTextColor="#8B97A8">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="textEmailAddress" android:textColor="#071A3D" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Password -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Password" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="#FFFFFF" app:hintTextColor="#8B97A8"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="textPassword" android:textColor="#071A3D" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Confirm Password -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Confirm Password" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="#FFFFFF" app:hintTextColor="#8B97A8"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextConfirmPassword"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="textPassword" android:textColor="#071A3D" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button android:id="@+id/buttonContinue"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Create Account" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/bg_button_gradient" app:backgroundTint="@null"
            android:layout_marginBottom="24dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Already have an account? " android:textColor="#8B97A8" android:textSize="14sp"/>
            <TextView android:id="@+id/textViewSignIn"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sign In" android:textColor="#8A2EFF" android:textSize="14sp"
                android:textStyle="bold" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>