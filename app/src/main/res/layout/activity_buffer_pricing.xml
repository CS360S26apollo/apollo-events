<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- ── PURPLE HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_button_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous" app:tint="#FFFFFF" android:contentDescription="Back" android:layout_marginEnd="10dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buffer &amp; Pricing" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Configure your session settings" android:textColor="#CCFFFFFF" android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="40dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── HOURLY RATE CARD (purple bg) ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#8A2EFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Rate display -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#33FFFFFF" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🪙" android:textSize="18sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hourly Rate" android:textColor="#CCFFFFFF" android:textSize="12sp" />
                            <TextView android:id="@+id/tvSelectedRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 Tokens" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rate preset buttons row 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                        <Button android:id="@+id/btnRate50"  android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:backgroundTint="#33FFFFFF" android:text="50"  android:textAllCaps="false" android:textColor="#CCFFFFFF" android:textSize="14sp" app:cornerRadius="10dp" />
                        <Button android:id="@+id/btnRate75"  android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:backgroundTint="#33FFFFFF" android:text="75"  android:textAllCaps="false" android:textColor="#CCFFFFFF" android:textSize="14sp" app:cornerRadius="10dp" />
                        <Button android:id="@+id/btnRate100" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#FFFFFF"       android:text="100" android:textAllCaps="false" android:textColor="#8A2EFF"  android:textSize="14sp" android:textStyle="bold" app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Rate preset buttons row 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnRate150" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:backgroundTint="#33FFFFFF" android:text="150" android:textAllCaps="false" android:textColor="#CCFFFFFF" android:textSize="14sp" app:cornerRadius="10dp" />
                        <Button android:id="@+id/btnRate200" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:backgroundTint="#33FFFFFF" android:text="200" android:textAllCaps="false" android:textColor="#CCFFFFFF" android:textSize="14sp" app:cornerRadius="10dp" />
                        <Button android:id="@+id/btnRate300" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#33FFFFFF" android:text="300" android:textAllCaps="false" android:textColor="#CCFFFFFF" android:textSize="14sp" app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ESTIMATED EARNINGS ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ " android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated Earnings" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#E6FAF0" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <TextView android:id="@+id/tvEarningsDaily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="400" android:textColor="#00C853" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvEarningsDailyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily (4h)" android:textColor="#4B5D7A" android:textSize="11sp" android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#EEF2FF" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <TextView android:id="@+id/tvEarningsWeekly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2000" android:textColor="#0062FF" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvEarningsWeeklyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weekly (20h)" android:textColor="#4B5D7A" android:textSize="11sp" android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardCornerRadius="16dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <TextView android:id="@+id/tvEarningsMonthly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8000" android:textColor="#8A2EFF" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvEarningsMonthlyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly (80h)" android:textColor="#4B5D7A" android:textSize="11sp" android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BUFFER TIME ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#EEF2FF" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🕒" android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buffer Time" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Break between sessions" android:textColor="#8B97A8" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/tvBufferLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Selected: 15 minutes" android:textColor="#4B5D7A" android:textSize="13sp" />
                        <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardBackgroundColor="#EEF2FF" app:cardElevation="0dp">
                            <TextView android:id="@+id/tvBufferBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="15min" android:textColor="#0062FF" android:textSize="12sp" android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarBuffer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="55"
                        android:progress="10"
                        android:progressTint="#0062FF"
                        android:thumbTint="#0062FF"
                        android:layout_marginBottom="12dp" />

                    <!-- Quick buttons: 5 10 15 30 45 60 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnBuffer5"  android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="#F3F4F6" android:text="5"  android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="12sp" app:cornerRadius="8dp" />
                        <Button android:id="@+id/btnBuffer10" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="#F3F4F6" android:text="10" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="12sp" app:cornerRadius="8dp" />
                        <Button android:id="@+id/btnBuffer15" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_button_gradient" android:text="15" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" app:backgroundTint="@null" app:cornerRadius="8dp" />
                        <Button android:id="@+id/btnBuffer30" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="#F3F4F6" android:text="30" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="12sp" app:cornerRadius="8dp" />
                        <Button android:id="@+id/btnBuffer45" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="#F3F4F6" android:text="45" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="12sp" app:cornerRadius="8dp" />
                        <Button android:id="@+id/btnBuffer60" android:layout_width="48dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#F3F4F6" android:text="60" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="12sp" app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── DEFAULT SESSION LENGTH ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#E6FAF0" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⏱️" android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Default Session" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Standard session length" android:textColor="#8B97A8" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnSession30" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="#F3F4F6" android:text="30" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnSession45" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="#F3F4F6" android:text="45" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnSession60" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="#00C853" android:text="60" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnSession90" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="#F3F4F6" android:text="90" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <Button android:id="@+id/btnSession120" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="#F3F4F6" android:text="120" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="min" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" android:layout_gravity="center" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BOOKING NOTICE ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#FFF0F3" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⏰" android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Booking Notice" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minimum advance notice" android:textColor="#8B97A8" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnNotice2"  android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#F3F4F6" android:text="2"  android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="h" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnNotice6"  android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#F3F4F6" android:text="6"  android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="h" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnNotice12" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#F3F4F6" android:text="12" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="h" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnNotice24" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_button_gradient" android:text="24" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@null" app:cornerRadius="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="h" android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_gravity="center" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                            <Button android:id="@+id/btnNotice48" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#F3F4F6" android:text="48" android:textAllCaps="false" android:textColor="#4B5D7A" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="12dp" />
