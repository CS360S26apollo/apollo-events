<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp"
    android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Subject icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="46dp" android:layout_height="46dp" android:layout_marginEnd="12dp"
                app:cardCornerRadius="14dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="📚" android:textSize="20sp"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTopic"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Topic" android:textColor="#071A3D"
                    android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvProviderName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tutor" android:textColor="#4B5D7A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Status badge -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardStatusBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#E6F2FF" app:cardElevation="0dp">
                <TextView android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Requested" android:textColor="#0062FF"
                    android:textSize="11sp" android:textStyle="bold"
                    android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Meta row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginEnd="8dp"
                app:cardCornerRadius="15dp" app:cardBackgroundColor="#F3F4F6" app:cardElevation="0dp">
                <TextView android:id="@+id/tvCategory"
                    android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:gravity="center" android:text="Subject" android:textColor="#4B5D7A"
                    android:textSize="12sp" android:paddingHorizontal="10dp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginEnd="8dp"
                app:cardCornerRadius="15dp" app:cardBackgroundColor="#F3F4F6" app:cardElevation="0dp">
                <TextView android:id="@+id/tvDuration"
                    android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:gravity="center" android:text="60 min" android:textColor="#4B5D7A"
                    android:textSize="12sp" android:paddingHorizontal="10dp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content" android:layout_height="30dp"
                app:cardCornerRadius="15dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪙 " android:textSize="12sp"/>
                    <TextView android:id="@+id/tvTokens"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#8A2EFF" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Date row -->
        <TextView android:id="@+id/tvLocation"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="" android:textColor="#8B97A8" android:textSize="12sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>