<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- Gradient header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="0dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gradient"
            android:orientation="vertical"
            android:paddingTop="48dp" android:paddingBottom="20dp"
            android:paddingHorizontal="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    app:cardCornerRadius="22dp" app:cardBackgroundColor="#33FFFFFF"
                    app:cardElevation="0dp">
                    <ImageButton android:id="@+id/btnBack"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_media_previous"
                        app:tint="#FFFFFF" android:contentDescription="Back"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Withdraw Earnings" android:textColor="#FFFFFF"
                    android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Balance card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Available Balance" android:textColor="#8B97A8" android:textSize="12sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🪙 " android:textSize="16sp"/>
                            <TextView android:id="@+id/tvAvailableBalance"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="#8A2EFF"
                                android:textSize="22sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="USD equivalent" android:textColor="#8B97A8" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvUsdEquivalent"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0.00" android:textColor="#071A3D"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- Step 1: Amount -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1. Enter Amount (tokens)"
                android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Quick amount chips -->
            <LinearLayout android:id="@+id/layoutQuickAmounts"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"/>

            <!-- Manual amount input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪙  " android:textSize="18sp"/>
                    <EditText android:id="@+id/etWithdrawAmount"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:hint="Enter token amount"
                        android:inputType="number" android:textSize="16sp"
                        android:textColor="#071A3D"
                        android:textColorHint="#8B97A8"
                        android:background="@android:color/transparent"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Minimum withdrawal: 100 tokens ($10)"
                android:textColor="#8B97A8" android:textSize="12sp"
                android:layout_marginBottom="24dp"/>

            <!-- Step 2: Payment method -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2. Select Payment Method"
                android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:id="@+id/layoutWithdrawMethods"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="20dp"/>

            <!-- Step 3: Payment details (populated dynamically) -->
            <LinearLayout android:id="@+id/layoutPaymentDetails"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- Info note -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#EEF9F3"
                app:strokeColor="#C8E6C9" app:strokeWidth="1dp" app:cardElevation="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔒  Your payment details are saved securely. A PIN is required for all withdrawals and changes."
                    android:textColor="#4B5D7A" android:textSize="13sp"
                    android:padding="14dp" android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Confirm button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFFF" android:elevation="8dp" android:padding="16dp">
        <Button android:id="@+id/btnConfirmWithdrawal"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Confirm Withdrawal" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:background="@drawable/bg_button_gradient" app:backgroundTint="@null"
            android:enabled="false" android:alpha="0.4"/>
    </LinearLayout>

</LinearLayout>