<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp"
    android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">

        <!-- Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="14dp"
            app:cardCornerRadius="28dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
            <TextView android:id="@+id/tvTutorInitials"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="T" android:textColor="#8A2EFF"
                android:textSize="20sp" android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTutorName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tutor Name" android:textColor="#071A3D"
                    android:textSize="15sp" android:textStyle="bold"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/badgeVerified"
                    android:layout_width="wrap_content" android:layout_height="20dp"
                    android:layout_marginStart="8dp" android:visibility="gone"
                    app:cardCornerRadius="10dp" app:cardBackgroundColor="#EAF9EE" app:cardElevation="0dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center" android:text="✓ Verified" android:textColor="#00C853"
                        android:textSize="10sp" android:paddingHorizontal="8dp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <TextView android:id="@+id/tvTutorSubjects"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Subject" android:textColor="#4B5D7A" android:textSize="13sp"
                android:layout_marginTop="2dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvRating"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⭐ 0.0" android:textColor="#071A3D" android:textSize="12sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  •  " android:textColor="#8B97A8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvTutorRate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#8A2EFF" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" tokens/hr" android:textColor="#8B97A8" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Arrow -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#8B97A8" android:textSize="24sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>