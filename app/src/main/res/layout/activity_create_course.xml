<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- ── Gradient Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_gradient"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="22dp" app:cardBackgroundColor="#33FFFFFF"
            app:cardElevation="0dp">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" android:contentDescription="Back"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Create Course" android:textColor="#FFFFFF"
                android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Set up your crash course"
                android:textColor="#CCFFFFFF" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Form ── -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- ── Basic Info card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📋 " android:textSize="18sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Basic Information" android:textColor="#071A3D"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Course title -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Course Title *" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCourseTitle"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="e.g. A-Level Maths Crash Course"
                            android:inputType="textCapSentences" android:padding="16dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Subject -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Subject *" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Select subject"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <AutoCompleteTextView android:id="@+id/spinnerCourseSubject"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:padding="16dp"
                            android:textColor="#071A3D"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Level -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Level *" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Select level"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <AutoCompleteTextView android:id="@+id/spinnerCourseLevel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:padding="16dp"
                            android:textColor="#071A3D"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Description *" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCourseDescription"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Describe what students will learn..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3" android:gravity="top" android:padding="16dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Schedule card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📅 " android:textSize="18sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Schedule" android:textColor="#071A3D"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Duration + sessions row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="14dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Duration (days)" android:textColor="#071A3D"
                                android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etDurationDays"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="30" android:inputType="number" android:padding="14dp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Sessions / week" android:textColor="#071A3D"
                                android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSessionsPerWeek"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="5" android:inputType="number" android:padding="14dp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Minutes per session -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Minutes per session" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSessionMinutes"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="60" android:inputType="number" android:padding="16dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Pricing & Capacity card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🪙 " android:textSize="18sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pricing &amp; Capacity" android:textColor="#071A3D"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Total Tokens *" android:textColor="#071A3D"
                                android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTotalTokens"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="500" android:inputType="number" android:padding="14dp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Max Students" android:textColor="#071A3D"
                                android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMaxStudents"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="10" android:inputType="number" android:padding="14dp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Topics & Session Type card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⚙️ " android:textSize="18sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Topics &amp; Format" android:textColor="#071A3D"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Topics -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Topics Covered (comma-separated)"
                        android:textColor="#071A3D" android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTopics"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Integration, Differentiation, Vectors..."
                            android:inputType="textCapSentences" android:padding="16dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Session type -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Session Format" android:textColor="#071A3D"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Select format"
                        app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                        <AutoCompleteTextView android:id="@+id/spinnerCourseType"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:padding="16dp"
                            android:textColor="#071A3D"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Zoom link (online only) -->
                    <LinearLayout android:id="@+id/layoutZoomLink"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🎥 Zoom Meeting Link" android:textColor="#071A3D"
                            android:textSize="13sp" android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            app:boxBackgroundColor="#F3F4F6" app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeWidth="0dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etZoomLink"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:hint="https://zoom.us/j/your-meeting-id"
                                android:inputType="textUri" android:padding="16dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💡 Create a recurring meeting on zoom.us and paste the link"
                            android:textColor="#8B97A8" android:textSize="11sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Create button ── -->
            <Button android:id="@+id/btnCreateCourse"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:text="Create Course" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_button_gradient"
                app:backgroundTint="@null" app:cornerRadius="28dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>