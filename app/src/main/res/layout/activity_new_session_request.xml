<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- ── GRADIENT HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_button_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="20dp">

        <!-- Back + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"
                app:tint="#FFFFFF"
                android:layout_marginEnd="14dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Session Request"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find the perfect tutor for your needs"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── FORM ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Subject / Topic card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📖 " android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subject &amp; Topic" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subject" android:textColor="#1F355B" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        android:hint="Select a subject"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#F3F4F6"
                        app:boxStrokeWidth="0dp">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerSubject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:padding="16dp"
                            android:textColor="#071A3D" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Topic / Title" android:textColor="#1F355B" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F3F4F6"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g., Calculus II - Integration Techniques"
                            android:inputType="textCapSentences"
                            android:padding="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Goals card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯 " android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Session Goals" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="What do you want to achieve?" android:textColor="#1F355B" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F3F4F6"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGoals"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g., Need help understanding integration by parts and trigonometric substitution for my upcoming exam."
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:gravity="top"
                            android:padding="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Quick goal chips -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick select:" android:textColor="#8B97A8" android:textSize="12sp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGoals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipExamPrep"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exam Prep"
                            app:chipBackgroundColor="#E0E0E0"
                            android:textColor="#33476A"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHomework"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Homework Help"
                            app:chipBackgroundColor="#E0E0E0"
                            android:textColor="#33476A"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipConceptReview"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Concept Review"
                            app:chipBackgroundColor="#E0E0E0"
                            android:textColor="#33476A"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipProblemSolving"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Problem Solving"
                            app:chipBackgroundColor="#E0E0E0"
                            android:textColor="#33476A"
                            app:chipStrokeWidth="0dp" />
                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Duration card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ " android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Session Duration" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="How long do you need?" android:textColor="#1F355B" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="12dp" />

                    <!-- Duration buttons row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn30min"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="30m"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#4B5D7A"
                            android:backgroundTint="#F3F4F6"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btn45min"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="45m"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#4B5D7A"
                            android:backgroundTint="#F3F4F6"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btn60min"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="60m"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#4B5D7A"
                            android:backgroundTint="#F3F4F6"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btn90min"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="90m"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#4B5D7A"
                            android:backgroundTint="#F3F4F6"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <!-- Custom duration -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom duration (minutes)" android:textColor="#1F355B" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#F3F4F6"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g., 75"
                            android:inputType="number"
                            android:padding="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Token cost preview -->
                    <TextView
                        android:id="@+id/tvTokenCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Cost: 0 tokens"
                        android:textColor="#089A3C"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- ── Session Type ── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Session Type" android:textColor="#071A3D"
                android:textSize="14sp" android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnSessionOnline"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:text="💻 Online"
                    android:textAllCaps="false" android:textSize="12sp"
                    android:textColor="#4B5D7A"
                    android:backgroundTint="#F3F4F6"/>
                <Button android:id="@+id/btnSessionInPerson"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:text="🏫 In-Person"
                    android:textAllCaps="false" android:textSize="12sp"
                    android:textColor="#4B5D7A"
                    android:backgroundTint="#F3F4F6"/>
                <Button android:id="@+id/btnSessionTakeHome"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="🏠 Take-Home" android:textAllCaps="false" android:textSize="12sp"
                    android:textColor="#4B5D7A"
                    android:backgroundTint="#F3F4F6"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏠 Take-home adds 25% extra — tutor travels to you"
                android:textColor="#8B97A8" android:textSize="11sp" android:layout_marginBottom="16dp"/>

            <!-- Location section — visible only when Take-Home selected -->
            <LinearLayout android:id="@+id/layoutLocationSection"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"
                android:layout_marginBottom="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="#F9F5FF"
                    app:strokeColor="#8A2EFF" app:strokeWidth="1dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Your Location" android:textColor="#8A2EFF"
                            android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                        <TextView android:id="@+id/tvStudentLocation"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Location not captured yet"
                            android:textColor="#8B97A8" android:textSize="13sp"
                            android:layout_marginBottom="10dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button android:id="@+id/btnGetLocation"
                                android:layout_width="0dp" android:layout_height="44dp"
                                android:layout_weight="1" android:layout_marginEnd="8dp"
                                android:text="📍 Get My Location" android:textAllCaps="false"
                                android:textSize="12sp" android:textColor="#FFFFFF"
                                android:background="@drawable/bg_button_gradient"
                                app:backgroundTint="@null"/>
                            <Button android:id="@+id/btnViewOnMap"
                                android:layout_width="0dp" android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="🗺 View Map" android:textAllCaps="false"
                                android:textSize="12sp" android:textColor="#8A2EFF"
                                android:background="@android:color/transparent"
                                app:backgroundTint="@null"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Proposed Date card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProposedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#0062FF" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📅" android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proposed Date" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#EEF2FF"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                            <TextView
                                android:id="@+id/tvProposedDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tap to select date"
                                android:textColor="#4B5D7A"
                                android:textSize="15sp"
                                android:clickable="true"
                                android:focusable="true" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#0062FF" android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📌 Past dates are not selectable" android:textColor="#8B97A8" android:textSize="12sp" android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Proposed Time card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProposedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#00C853" app:cardElevation="0dp">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🕒" android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proposed Time" android:textColor="#071A3D" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#E6FAF0"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                            <TextView
                                android:id="@+id/tvProposedTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tap to select time"
                                android:textColor="#4B5D7A"
                                android:textSize="15sp"
                                android:clickable="true"
                                android:focusable="true" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#00C853" android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕐 24-hour format (e.g. 14:30)" android:textColor="#8B97A8" android:textSize="12sp" android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit button -->
            <Button
                android:id="@+id/btnSubmitRequest"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_gradient"
                android:text="Post Session Request"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>