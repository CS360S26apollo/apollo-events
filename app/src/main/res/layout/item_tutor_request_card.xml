<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp"
    android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

        <!-- Accent bar -->
        <View android:id="@+id/viewAccentBar"
            android:layout_width="4dp" android:layout_height="60dp"
            android:layout_marginEnd="14dp"
            android:background="#8A2EFF"/>

        <!-- Avatar -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardStudentAvatar"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
            <TextView android:id="@+id/tvStudentInitials"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="S" android:textColor="#8A2EFF"
                android:textSize="18sp" android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvStudentName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Student Name" android:textColor="#071A3D"
                android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvSubject"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Subject" android:textColor="#8A2EFF" android:textSize="13sp"/>
            <TextView android:id="@+id/tvTopic"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Topic" android:textColor="#4B5D7A" android:textSize="12sp"
                android:layout_marginTop="2dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvDate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date" android:textColor="#8B97A8" android:textSize="12sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  •  " android:textColor="#8B97A8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Time" android:textColor="#8B97A8" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Token badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="10dp" android:paddingVertical="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🪙 " android:textSize="13sp"/>
                <TextView android:id="@+id/tvTokens"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#8A2EFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>