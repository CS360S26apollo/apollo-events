<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- Gradient header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="0dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gradient" android:orientation="vertical"
            android:paddingTop="48dp" android:paddingBottom="24dp" android:paddingHorizontal="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Good morning 👋" android:textColor="#CCFFFFFF" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvUserName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Find Tutor" android:textColor="#FFFFFF"
                        android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>
                <!-- Token balance badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    app:cardCornerRadius="20dp" app:cardBackgroundColor="#33FFFFFF" app:cardElevation="0dp"
                    android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🪙 " android:textSize="14sp"/>
                        <TextView android:id="@+id/tvTokenBalance"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="100" android:textColor="#FFFFFF"
                            android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Search bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="52dp"
                app:cardCornerRadius="26dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔍  " android:textSize="16sp"/>
                    <TextView android:id="@+id/tvSearchHint"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Search tutors, subjects..."
                        android:textColor="#8B97A8" android:textSize="14sp"
                        android:clickable="true" android:focusable="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- Quick actions -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Quick Actions" android:textColor="#071A3D"
                android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBrowseTutors"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true"
                    app:cardCornerRadius="20dp" app:cardBackgroundColor="#8A2EFF" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔍" android:textSize="28sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Browse Tutors" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMyRequests"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:clickable="true" android:focusable="true"
                    app:cardCornerRadius="20dp" app:cardBackgroundColor="#0062FF" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📋" android:textSize="28sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="My Sessions" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Upcoming session -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Upcoming Session"
                    android:textColor="#071A3D" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvViewAll"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="View All" android:textColor="#0062FF" android:textSize="13sp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpcomingSession"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_marginEnd="14dp"
                        app:cardCornerRadius="16dp" app:cardBackgroundColor="#F3EEFF" app:cardElevation="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="📚" android:textSize="22sp"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvUpcomingSubject"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No upcoming sessions" android:textColor="#071A3D"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvUpcomingTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Book a session to get started"
                            android:textColor="#8B97A8" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Buy tokens CTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBuyTokens"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="@null" app:cardElevation="0dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_button_gradient"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Need more tokens?" android:textColor="#FFFFFF"
                            android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="10 tokens = $1 • Buy now" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪙" android:textSize="32sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="72dp"
        app:cardCornerRadius="0dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/navHome"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏠" android:textSize="20sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Home" android:textSize="10sp" android:textColor="#8A2EFF"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navBrowse"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔍" android:textSize="20sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Browse" android:textSize="10sp" android:textColor="#8B97A8"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navMessages"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋" android:textSize="20sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sessions" android:textSize="10sp" android:textColor="#8B97A8"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navProfile"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👤" android:textSize="20sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Profile" android:textSize="10sp" android:textColor="#8B97A8"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>