<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo area -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp" android:layout_height="90dp"
            android:layout_marginTop="48dp" android:layout_marginBottom="20dp"
            app:cardCornerRadius="26dp" app:cardBackgroundColor="@null" app:cardElevation="0dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_app_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Find Tutor"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Welcome Back" android:textColor="#071A3D"
            android:textSize="28sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:layout_marginBottom="40dp"
            android:text="Sign in to your account"
            android:textColor="#8B97A8" android:textSize="15sp"/>

        <!-- Email card input -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Email" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="#FFFFFF" app:hintTextColor="#8B97A8">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="textEmailAddress" android:textColor="#071A3D" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Password card input -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="2dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Password" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
                app:boxBackgroundColor="#FFFFFF" app:hintTextColor="#8B97A8"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="textPassword" android:textColor="#071A3D" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/textViewForgotPassword"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end" android:layout_marginBottom="32dp"
            android:text="Forgot Password?" android:textColor="#8A2EFF" android:textSize="13sp"
            android:clickable="true" android:focusable="true"/>

        <!-- Primary gradient button -->
        <Button android:id="@+id/buttonSignIn"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Sign In" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/bg_button_gradient" app:backgroundTint="@null"
            android:layout_marginBottom="28dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Don't have an account? " android:textColor="#8B97A8" android:textSize="14sp"/>
            <TextView android:id="@+id/textViewSignUp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sign Up" android:textColor="#8A2EFF" android:textSize="14sp"
                android:textStyle="bold" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>