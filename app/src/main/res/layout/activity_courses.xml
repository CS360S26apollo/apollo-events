<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- ── Gradient Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_gradient"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="22dp" app:cardBackgroundColor="#33FFFFFF"
                app:cardElevation="0dp">
                <ImageButton android:id="@+id/btnBack"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF" android:contentDescription="Back"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Crash Courses" android:textColor="#FFFFFF"
                    android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Intensive courses by expert tutors"
                    android:textColor="#CCFFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Course list ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/layoutCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <!-- ── FAB: Create course (tutors only) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabCreateCourse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@null"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"
        style="@style/Widget.Material3.CardView.Elevated">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_gradient"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+ " android:textColor="#FFFFFF"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Create Course" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>