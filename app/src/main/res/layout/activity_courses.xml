<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F8">

    <!-- ── Gradient Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_gradient"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="22dp" app:cardBackgroundColor="#33FFFFFF"
                app:cardElevation="0dp">
                <ImageButton android:id="@+id/btnBack"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF" android:contentDescription="Back"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Crash Courses" android:textColor="#FFFFFF"
                    android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Intensive courses by expert tutors"
                    android:textColor="#CCFFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- ── Search + Sort bar ── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:layout_marginEnd="10dp"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔍  " android:textSize="15sp"/>
                <EditText android:id="@+id/etSearchCourses"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@android:color/transparent"
                    android:hint="Search courses..." android:textSize="13sp"
                    android:textColor="#071A3D" android:imeOptions="actionSearch"
                    android:inputType="text"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Spinner android:id="@+id/spinnerSort"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <!-- ── Subject filter chips ── -->
    <HorizontalScrollView android:id="@+id/hsvSubjectFilter"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ── Course list ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/layoutCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <!-- ── FAB: Create course (tutors only) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabCreateCourse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@null"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"
        style="@style/Widget.Material3.CardView.Elevated">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_gradient"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+ " android:textColor="#FFFFFF"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Create Course" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>